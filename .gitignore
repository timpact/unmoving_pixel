# --- ESP-IDF Build-Ausgaben ---
build/
**/build/

# --- ESP-IDF Konfiguration ---
# Die generierte sdkconfig wird nicht versioniert.
# Projektspezifische Einstellungen gehören in sdkconfig.defaults (wird committet).
sdkconfig
sdkconfig.old

# --- ESP-IDF Component Manager ---
# managed_components/ wird beim Build neu geladen,
# dependencies.lock dagegen committen (feste Versionen).
managed_components/
**/managed_components/

# --- ESPHome (falls für das Display genutzt) ---
.esphome/
**/.esphome/
secrets.yaml

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Editoren / IDEs ---
# Die ESP-IDF-Erweiterung schreibt maschinenspezifische Pfade in .vscode/
**/.vscode/*
!**/.vscode/extensions.json
.idea/
*.swp
*~

# --- Betriebssysteme ---
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code (lokale Arbeitsnotizen, nicht versioniert) ---
CLAUDE.md
CLAUDE.local.md

# --- Sonstiges ---
*.log
