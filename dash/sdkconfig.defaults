# dash – ESP32-P4 (Guition JC4880P443)
CONFIG_IDF_TARGET="esp32p4"

# Early chip revisions (v1.x) are likely on this board.
# Without this, the bootloader refuses to start on revisions < 3.0.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

# 16 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 32 MB PSRAM (needed later for LVGL frame buffers)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

# The board uses a Boya flash chip (detected at boot)
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

# LVGL (ADR 0019): use dash/ui/lv_conf.h instead of Kconfig
CONFIG_LV_CONF_SKIP=n

# GUI performance (ADR 0019): code and constants (fonts) run from PSRAM instead
# of the 40 MHz flash – rendering 38 → 21 ms per frame
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Partition table (ADR 0019): NVS, two 4 MB app slots, C6 image, core dump
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Crash reports into the coredump partition (read with idf.py coredump-info)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# Larger L2 cache with 128-byte lines for PSRAM code and frame buffers (ADR 0019)
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
